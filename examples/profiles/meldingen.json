{
  "id": "nl.vng.meldingen",
  "version": "0.2.0",
  "title": "Meldingen openbare ruimte (simulatievoorbeeld)",
  "personas": [
    {
      "id": "https://id.example.nl/priya",
      "label": "Priya (inwoner, melder)",
      "claims": {
        "rol": "inwoner"
      }
    },
    {
      "id": "https://id.example.nl/karel",
      "label": "Karel (andere inwoner)",
      "claims": {
        "rol": "inwoner"
      }
    },
    {
      "id": "https://id.example.nl/ahmed",
      "label": "Ahmed (team buitenruimte)",
      "claims": {
        "rol": "medewerker",
        "team": "buitenruimte"
      }
    },
    {
      "id": "https://id.example.nl/kim",
      "label": "Kim (KCC-medewerker)",
      "claims": {
        "rol": "kcc"
      }
    },
    {
      "id": "https://id.example.nl/signalen",
      "label": "Signalen (meldingen-API)",
      "claims": {
        "rol": "systeem"
      }
    }
  ],
  "types": {
    "nl.vng.meldingen.melding": {
      "allowCommits": false,
      "queryable": [
        "status",
        "categorie",
        "subcategorie",
        "team",
        "wijk",
        "zaaknummer",
        "kanaal",
        "prioriteit",
        "behandelaar",
        "melder.partij",
        "gemeld"
      ],
      "schema": {
        "type": "object",
        "required": [
          "zaaknummer",
          "categorie",
          "omschrijving",
          "status",
          "locatie",
          "team"
        ],
        "properties": {
          "zaaknummer": {
            "type": "string"
          },
          "categorie": {
            "type": "string"
          },
          "subcategorie": {
            "type": "string"
          },
          "omschrijving": {
            "type": "string"
          },
          "status": {
            "enum": [
              "gemeld",
              "in behandeling",
              "ingepland",
              "afgehandeld",
              "heropend"
            ]
          },
          "prioriteit": {
            "enum": [
              "laag",
              "normaal",
              "hoog"
            ]
          },
          "locatie": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "const": "Point"
              },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "adres": {
            "type": "string"
          },
          "wijk": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "behandelaar": {
            "type": "string"
          },
          "kanaal": {
            "enum": [
              "app",
              "website",
              "telefoon",
              "e-mail"
            ]
          },
          "melder": {
            "type": "object",
            "required": [
              "partij",
              "rol"
            ],
            "properties": {
              "partij": {
                "type": "string"
              },
              "rol": {
                "type": "string"
              }
            }
          },
          "fotos": {
            "type": "integer"
          }
        }
      },
      "rules": {
        "read": "melder.partij = actor() OR team = actor('team') OR actor('rol') IN ('kcc', 'systeem', 'inwoner')",
        "create": "melder.partij = actor() OR actor('rol') IN ('kcc', 'systeem')",
        "append": "melder.partij = actor()",
        "write": "team = actor('team') OR actor('rol') = 'systeem'",
        "fields": [
          {
            "when": "actor('rol') = 'kcc'",
            "show": [
              "zaaknummer",
              "categorie",
              "subcategorie",
              "status",
              "prioriteit",
              "locatie",
              "adres",
              "wijk",
              "team",
              "gemeld",
              "ingepland",
              "afgehandeld"
            ]
          },
          {
            "when": "actor('rol') = 'inwoner' AND melder.partij <> actor()",
            "show": [
              "zaaknummer",
              "categorie",
              "subcategorie",
              "status",
              "locatie",
              "wijk",
              "gemeld",
              "afgehandeld.tijd"
            ]
          }
        ]
      }
    }
  },
  "events": {
    "nl.vng.meldingen.melding.gedaan": {
      "subjectType": "nl.vng.meldingen.melding",
      "creates": true,
      "dataschema": {
        "type": "object",
        "required": [
          "zaaknummer",
          "categorie",
          "omschrijving",
          "locatie",
          "team"
        ],
        "properties": {
          "zaaknummer": {
            "type": "string"
          },
          "categorie": {
            "type": "string"
          },
          "subcategorie": {
            "type": "string"
          },
          "omschrijving": {
            "type": "string",
            "minLength": 1
          },
          "locatie": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "const": "Point"
              },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "adres": {
            "type": "string"
          },
          "wijk": {
            "type": "string"
          },
          "kanaal": {
            "enum": [
              "app",
              "website",
              "telefoon",
              "e-mail"
            ]
          },
          "melder": {
            "type": "object",
            "required": [
              "partij",
              "rol"
            ],
            "properties": {
              "partij": {
                "type": "string"
              },
              "rol": {
                "type": "string"
              }
            }
          },
          "team": {
            "type": "string"
          },
          "prioriteit": {
            "enum": [
              "laag",
              "normaal",
              "hoog"
            ]
          },
          "fotos": {
            "type": "integer"
          }
        }
      },
      "projection": [
        {
          "op": "set",
          "path": "zaaknummer",
          "value": "$data.zaaknummer"
        },
        {
          "op": "set",
          "path": "categorie",
          "value": "$data.categorie"
        },
        {
          "op": "set",
          "path": "subcategorie",
          "value": "$data.subcategorie"
        },
        {
          "op": "set",
          "path": "omschrijving",
          "value": "$data.omschrijving"
        },
        {
          "op": "set",
          "path": "locatie",
          "value": "$data.locatie"
        },
        {
          "op": "set",
          "path": "adres",
          "value": "$data.adres"
        },
        {
          "op": "set",
          "path": "wijk",
          "value": "$data.wijk"
        },
        {
          "op": "set",
          "path": "kanaal",
          "value": "$data.kanaal"
        },
        {
          "op": "set",
          "path": "melder",
          "value": "$data.melder"
        },
        {
          "op": "set",
          "path": "team",
          "value": "$data.team"
        },
        {
          "op": "set",
          "path": "prioriteit",
          "value": "$data.prioriteit"
        },
        {
          "op": "set",
          "path": "fotos",
          "value": "$data.fotos"
        },
        {
          "op": "set",
          "path": "status",
          "value": "gemeld"
        },
        {
          "op": "set",
          "path": "gemeld",
          "value": "$time"
        }
      ]
    },
    "nl.vng.meldingen.melding.toegewezen": {
      "subjectType": "nl.vng.meldingen.melding",
      "right": "write",
      "dataschema": {
        "type": "object",
        "required": [
          "behandelaar"
        ],
        "properties": {
          "behandelaar": {
            "type": "string"
          }
        }
      },
      "projection": [
        {
          "op": "set",
          "path": "behandelaar",
          "value": "$data.behandelaar"
        },
        {
          "op": "set",
          "path": "status",
          "value": "in behandeling"
        }
      ]
    },
    "nl.vng.meldingen.melding.ingepland": {
      "subjectType": "nl.vng.meldingen.melding",
      "right": "write",
      "dataschema": {
        "type": "object",
        "required": [
          "datum"
        ],
        "properties": {
          "datum": {
            "type": "string",
            "format": "date"
          },
          "uitvoerder": {
            "type": "string"
          },
          "toelichting": {
            "type": "string"
          }
        }
      },
      "projection": [
        {
          "op": "set",
          "path": "status",
          "value": "ingepland"
        },
        {
          "op": "set",
          "path": "ingepland",
          "value": {
            "datum": "$data.datum",
            "uitvoerder": "$data.uitvoerder"
          }
        }
      ]
    },
    "nl.vng.meldingen.melding.aangevuld": {
      "subjectType": "nl.vng.meldingen.melding",
      "right": "append",
      "dataschema": {
        "type": "object",
        "required": [
          "tekst"
        ],
        "properties": {
          "tekst": {
            "type": "string",
            "minLength": 1
          },
          "fotos": {
            "type": "integer"
          }
        }
      },
      "projection": [
        {
          "op": "append",
          "path": "aanvullingen",
          "value": {
            "tekst": "$data.tekst",
            "fotos": "$data.fotos",
            "tijd": "$time"
          }
        }
      ]
    },
    "nl.vng.meldingen.melding.afgehandeld": {
      "subjectType": "nl.vng.meldingen.melding",
      "right": "write",
      "dataschema": {
        "type": "object",
        "required": [
          "resultaat"
        ],
        "properties": {
          "resultaat": {
            "enum": [
              "opgelost",
              "doorgezet naar derde",
              "dubbele melding",
              "niet gevonden"
            ]
          },
          "toelichting": {
            "type": "string"
          }
        }
      },
      "projection": [
        {
          "op": "set",
          "path": "status",
          "value": "afgehandeld"
        },
        {
          "op": "set",
          "path": "afgehandeld",
          "value": {
            "door": "$actor",
            "tijd": "$time",
            "resultaat": "$data.resultaat",
            "toelichting": "$data.toelichting"
          }
        }
      ]
    },
    "nl.vng.meldingen.melding.heropend": {
      "subjectType": "nl.vng.meldingen.melding",
      "right": "append",
      "dataschema": {
        "type": "object",
        "required": [
          "reden"
        ],
        "properties": {
          "reden": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "projection": [
        {
          "op": "set",
          "path": "status",
          "value": "heropend"
        },
        {
          "op": "increment",
          "path": "heropend"
        }
      ]
    },
    "nl.vng.meldingen.melding.tevredenheid_gegeven": {
      "subjectType": "nl.vng.meldingen.melding",
      "right": "write",
      "dataschema": {
        "type": "object",
        "required": [
          "score"
        ],
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "opmerking": {
            "type": "string"
          }
        }
      },
      "projection": [
        {
          "op": "set",
          "path": "tevredenheid",
          "value": {
            "score": "$data.score",
            "opmerking": "$data.opmerking"
          }
        }
      ]
    }
  }
}
