{
  "id": "nl.vng.meldingen",
  "version": "0.2.0",
  "title": "Meldingen openbare ruimte (simulatievoorbeeld)",
  "personas": [
    {
      "id": "https://id.example.nl/priya",
      "label": "Priya (inwoner, melder)",
      "claims": {
        "rol": "inwoner"
      }
    },
    {
      "id": "https://id.example.nl/karel",
      "label": "Karel (andere inwoner)",
      "claims": {
        "rol": "inwoner"
      }
    },
    {
      "id": "https://id.example.nl/ahmed",
      "label": "Ahmed (team buitenruimte)",
      "claims": {
        "rol": "medewerker",
        "team": "buitenruimte"
      }
    },
    {
      "id": "https://id.example.nl/kim",
      "label": "Kim (KCC-medewerker)",
      "claims": {
        "rol": "kcc"
      }
    },
    {
      "id": "https://id.example.nl/signalen",
      "label": "Signalen (meldingen-API)",
      "claims": {
        "rol": "systeem"
      }
    }
  ],
  "types": {
    "nl.vng.meldingen.melding": {
      "queryable": [
        "status",
        "categorie",
        "subcategorie",
        "team",
        "wijk",
        "zaaknummer",
        "kanaal",
        "prioriteit",
        "behandelaar",
        "melder.partij",
        "gemeld"
      ],
      "schema": {
        "type": "object",
        "required": [
          "zaaknummer",
          "categorie",
          "omschrijving",
          "status",
          "locatie",
          "team"
        ],
        "properties": {
          "zaaknummer": {
            "type": "string"
          },
          "categorie": {
            "type": "string"
          },
          "subcategorie": {
            "type": "string"
          },
          "omschrijving": {
            "type": "string"
          },
          "status": {
            "enum": [
              "gemeld",
              "in behandeling",
              "ingepland",
              "afgehandeld",
              "heropend"
            ]
          },
          "prioriteit": {
            "enum": [
              "laag",
              "normaal",
              "hoog"
            ]
          },
          "locatie": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "const": "Point"
              },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "adres": {
            "type": "string"
          },
          "wijk": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "behandelaar": {
            "type": "string"
          },
          "kanaal": {
            "enum": [
              "app",
              "website",
              "telefoon",
              "e-mail"
            ]
          },
          "melder": {
            "type": "object",
            "required": [
              "partij",
              "rol"
            ],
            "properties": {
              "partij": {
                "type": "string"
              },
              "rol": {
                "type": "string"
              }
            }
          },
          "fotos": {
            "type": "integer"
          },
          "gemeld": {
            "type": "string"
          },
          "ingepland": {
            "type": "object",
            "properties": {
              "datum": {
                "type": "string",
                "format": "date"
              },
              "uitvoerder": {
                "type": "string"
              },
              "toelichting": {
                "type": "string"
              }
            }
          },
          "resultaat": {
            "enum": [
              "opgelost",
              "doorgezet naar derde",
              "dubbele melding",
              "niet gevonden"
            ]
          },
          "toelichting": {
            "type": "string"
          },
          "afgehandeld": {
            "type": "object",
            "properties": {
              "door": {
                "type": "string"
              },
              "tijd": {
                "type": "string"
              }
            }
          },
          "heropenreden": {
            "type": "string"
          },
          "tevredenheid": {
            "type": "object",
            "required": [
              "score"
            ],
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "opmerking": {
                "type": "string"
              }
            }
          }
        }
      },
      "rules": {
        "read": "melder.partij = actor() OR team = actor('team') OR actor('rol') IN ('kcc', 'systeem', 'inwoner')",
        "create": "melder.partij = actor() OR actor('rol') IN ('kcc', 'systeem')",
        "write": "team = actor('team') OR actor('rol') = 'systeem'",
        "fields": [
          {
            "when": "actor('rol') = 'kcc'",
            "show": [
              "zaaknummer",
              "categorie",
              "subcategorie",
              "status",
              "prioriteit",
              "locatie",
              "adres",
              "wijk",
              "team",
              "gemeld",
              "ingepland",
              "afgehandeld",
              "resultaat"
            ]
          },
          {
            "when": "actor('rol') = 'inwoner' AND melder.partij <> actor()",
            "show": [
              "zaaknummer",
              "categorie",
              "subcategorie",
              "status",
              "locatie",
              "wijk",
              "gemeld",
              "afgehandeld.tijd"
            ]
          }
        ]
      }
    },
    "nl.vng.meldingen.aanvulling": {
      "queryable": [
        "melding",
        "door",
        "tijd"
      ],
      "schema": {
        "type": "object",
        "required": [
          "melding",
          "tekst",
          "door",
          "tijd"
        ],
        "properties": {
          "melding": {
            "type": "string"
          },
          "tekst": {
            "type": "string",
            "minLength": 1
          },
          "fotos": {
            "type": "integer"
          },
          "door": {
            "type": "string"
          },
          "tijd": {
            "type": "string"
          }
        }
      },
      "rules": {
        "read": "melding.melder.partij = actor() OR melding.team = actor('team') OR actor('rol') IN ('kcc', 'systeem')"
      },
      "references": [
        "melding"
      ]
    }
  },
  "actions": {
    "nl.vng.meldingen.melding.gedaan": {
      "title": "Melding doen",
      "commits": [
        {
          "type": "nl.vng.meldingen.melding",
          "op": "create",
          "fields": [
            "zaaknummer",
            "categorie",
            "subcategorie",
            "omschrijving",
            "locatie",
            "adres",
            "wijk",
            "kanaal",
            "melder",
            "team",
            "prioriteit",
            "fotos"
          ],
          "set": {
            "status": "gemeld",
            "gemeld": "$time"
          }
        }
      ]
    },
    "nl.vng.meldingen.melding.toegewezen": {
      "title": "Toewijzen",
      "commits": [
        {
          "type": "nl.vng.meldingen.melding",
          "op": "update",
          "fields": [
            "behandelaar"
          ],
          "set": {
            "status": "in behandeling"
          }
        }
      ]
    },
    "nl.vng.meldingen.melding.ingepland": {
      "title": "Inplannen",
      "commits": [
        {
          "type": "nl.vng.meldingen.melding",
          "op": "update",
          "fields": [
            "ingepland"
          ],
          "set": {
            "status": "ingepland"
          }
        }
      ]
    },
    "nl.vng.meldingen.melding.aangevuld": {
      "title": "Aanvullen",
      "commits": [
        {
          "type": "nl.vng.meldingen.aanvulling",
          "op": "create",
          "fields": [
            "melding",
            "tekst",
            "fotos"
          ],
          "set": {
            "door": "$actor",
            "tijd": "$time"
          },
          "rule": "melding.melder.partij = actor() AND melding.status <> 'afgehandeld'"
        }
      ]
    },
    "nl.vng.meldingen.melding.afgehandeld": {
      "title": "Afhandelen",
      "commits": [
        {
          "type": "nl.vng.meldingen.melding",
          "op": "update",
          "fields": [
            "resultaat",
            "toelichting"
          ],
          "set": {
            "status": "afgehandeld",
            "afgehandeld": {
              "door": "$actor",
              "tijd": "$time"
            }
          }
        }
      ]
    },
    "nl.vng.meldingen.melding.heropend": {
      "title": "Heropenen",
      "commits": [
        {
          "type": "nl.vng.meldingen.melding",
          "op": "update",
          "fields": [
            "heropenreden"
          ],
          "set": {
            "status": "heropend"
          },
          "rule": "melder.partij = actor() AND status = 'afgehandeld'"
        }
      ]
    },
    "nl.vng.meldingen.melding.tevredenheid_gegeven": {
      "title": "Tevredenheid geven",
      "commits": [
        {
          "type": "nl.vng.meldingen.melding",
          "op": "update",
          "fields": [
            "tevredenheid"
          ],
          "rule": "melder.partij = actor() OR actor('rol') = 'systeem'"
        }
      ]
    }
  }
}
