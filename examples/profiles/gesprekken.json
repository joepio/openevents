{
  "id": "nl.vng.gesprekken",
  "version": "0.3.0",
  "title": "MijnGesprekken als profiel op OpenEvents",
  "description": "Gesprekken en bijdragen. De vorm komt uit het VNG API Lab (schemas/gesprekken/next.json); dit profiel voegt de handelingen, de regels en twee eigen velden toe: team (wie bij de gemeente het gesprek behandelt) en afsluitreden.",
  "personas": [
    {
      "id": "https://id.example.nl/suzanne",
      "label": "Suzanne (inwoner)",
      "claims": {
        "rol": "inwoner"
      }
    },
    {
      "id": "https://id.example.nl/lukas",
      "label": "Lukas (curator van Suzanne)",
      "claims": {
        "rol": "curator"
      }
    },
    {
      "id": "https://id.example.nl/merve",
      "label": "Merve (Wmo-consulent)",
      "claims": {
        "rol": "medewerker",
        "team": "wmo"
      }
    },
    {
      "id": "https://id.example.nl/kim",
      "label": "Kim (KCC-medewerker)",
      "claims": {
        "rol": "kcc"
      }
    },
    {
      "id": "https://id.example.nl/karel",
      "label": "Karel (andere inwoner)",
      "claims": {
        "rol": "inwoner"
      }
    }
  ],
  "types": {
    "nl.vng.gesprekken.gesprek": {
      "schema": {
        "allOf": [
          {
            "$ref": "https://raw.githubusercontent.com/VNG-Realisatie/vng-api-lab/main/schemas/gesprekken/next.json#/$defs/Gesprek"
          },
          {
            "properties": {
              "team": {
                "type": "string"
              },
              "afsluitreden": {
                "type": "string"
              }
            }
          }
        ]
      },
      "queryable": [
        "gespreksonderwerp",
        "team",
        "aanleidingZaak",
        "gespreksdeelnames.partij",
        "gespreksdeelnames.actor",
        "aanvangsmomentGesprek",
        "momentEindeGesprek"
      ],
      "references": [
        "aanleidingZaak"
      ],
      "rules": {
        "read": "(gespreksdeelnames.partij = actor() OR gespreksdeelnames.actor = actor()) OR team = actor('team') OR actor('rol') = 'kcc'",
        "create": "(gespreksdeelnames.partij = actor() OR gespreksdeelnames.actor = actor()) OR team = actor('team')",
        "write": "team = actor('team')",
        "fields": [
          {
            "when": "actor('rol') = 'kcc'",
            "show": [
              "gespreksonderwerp",
              "aanleidingZaak",
              "team",
              "aanvangsmomentGesprek",
              "momentEindeGesprek"
            ]
          }
        ],
        "mine": "gespreksdeelnames.partij = actor()"
      }
    },
    "nl.vng.gesprekken.bijdrage": {
      "schema": {
        "$ref": "https://raw.githubusercontent.com/VNG-Realisatie/vng-api-lab/main/schemas/gesprekken/next.json#/$defs/Gespreksbijdrage"
      },
      "queryable": [
        "gesprek",
        "verzender",
        "leveringsmoment",
        "automatisch"
      ],
      "references": [
        "gesprek"
      ],
      "rules": {
        "read": "(gesprek.gespreksdeelnames.partij = actor() OR gesprek.gespreksdeelnames.actor = actor()) OR gesprek.team = actor('team')",
        "mine": "gesprek.gespreksdeelnames.partij = actor()"
      }
    }
  },
  "actions": {
    "nl.vng.gesprekken.gesprek.gestart": {
      "title": "Gesprek starten",
      "commits": [
        {
          "type": "nl.vng.gesprekken.gesprek",
          "op": "create",
          "fields": [
            "gespreksonderwerp",
            "team",
            "aanleidingZaak",
            "aanleidingThema",
            "aanleidingProductDienst",
            "aanleidingAgendaAfspraak",
            "aanleidingPlan",
            "gespreksdeelnames"
          ],
          "set": {
            "aanvangsmomentGesprek": "$time"
          }
        },
        {
          "type": "nl.vng.gesprekken.bijdrage",
          "op": "create",
          "fields": [
            "gesprek",
            "tekstGespreksBijdrage",
            "bijlagen"
          ],
          "set": {
            "verzender": "$actor",
            "leveringsmoment": "$time"
          },
          "rule": "(gesprek.gespreksdeelnames.partij = actor() OR gesprek.gespreksdeelnames.actor = actor()) OR gesprek.team = actor('team')"
        }
      ]
    },
    "nl.vng.gesprekken.deelname.toegevoegd": {
      "title": "Deelnemer toevoegen",
      "commits": [
        {
          "type": "nl.vng.gesprekken.gesprek",
          "op": "update",
          "fields": [
            "gespreksdeelnames"
          ],
          "rule": "team = actor('team') AND momentEindeGesprek IS NULL"
        }
      ]
    },
    "nl.vng.gesprekken.bijdrage.toegevoegd": {
      "title": "Bijdrage plaatsen",
      "commits": [
        {
          "type": "nl.vng.gesprekken.bijdrage",
          "op": "create",
          "fields": [
            "gesprek",
            "tekstGespreksBijdrage",
            "isReactieOp",
            "bijlagen",
            "automatisch"
          ],
          "set": {
            "verzender": "$actor",
            "leveringsmoment": "$time"
          },
          "rule": "((gesprek.gespreksdeelnames.partij = actor() OR gesprek.gespreksdeelnames.actor = actor()) OR gesprek.team = actor('team')) AND gesprek.momentEindeGesprek IS NULL"
        }
      ]
    },
    "nl.vng.gesprekken.gesprek.afgesloten": {
      "title": "Gesprek afsluiten",
      "commits": [
        {
          "type": "nl.vng.gesprekken.gesprek",
          "op": "update",
          "fields": [
            "afsluitreden",
            "contactmoment"
          ],
          "set": {
            "momentEindeGesprek": "$time"
          },
          "rule": "((gespreksdeelnames.partij = actor() OR gespreksdeelnames.actor = actor()) OR team = actor('team')) AND momentEindeGesprek IS NULL"
        }
      ]
    }
  }
}
