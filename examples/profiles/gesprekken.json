{
  "id": "nl.vng.gesprekken",
  "version": "0.2.0",
  "title": "MijnGesprekken als profiel op OpenEvents",
  "personas": [
    {
      "id": "https://id.example.nl/suzanne",
      "label": "Suzanne (inwoner)",
      "claims": {
        "rol": "inwoner"
      }
    },
    {
      "id": "https://id.example.nl/lukas",
      "label": "Lukas (curator van Suzanne)",
      "claims": {
        "rol": "curator"
      }
    },
    {
      "id": "https://id.example.nl/merve",
      "label": "Merve (Wmo-consulent)",
      "claims": {
        "rol": "medewerker",
        "team": "wmo"
      }
    },
    {
      "id": "https://id.example.nl/kim",
      "label": "Kim (KCC-medewerker)",
      "claims": {
        "rol": "kcc"
      }
    },
    {
      "id": "https://id.example.nl/karel",
      "label": "Karel (andere inwoner)",
      "claims": {
        "rol": "inwoner"
      }
    }
  ],
  "types": {
    "nl.vng.gesprekken.gesprek": {
      "queryable": [
        "status",
        "onderwerp",
        "team",
        "aanleiding.zaak",
        "deelnames.partij",
        "gestart"
      ],
      "schema": {
        "type": "object",
        "required": [
          "onderwerp",
          "status",
          "deelnames"
        ],
        "properties": {
          "onderwerp": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "afgesloten"
            ]
          },
          "team": {
            "type": "string"
          },
          "aanleiding": {
            "type": "object",
            "properties": {
              "zaak": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "gestart": {
            "type": "string"
          },
          "deelnames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "partij",
                "rol"
              ],
              "properties": {
                "partij": {
                  "type": "string"
                },
                "rol": {
                  "enum": [
                    "inwoner",
                    "curator",
                    "bewindvoerder",
                    "gemachtigde",
                    "behandelaar"
                  ]
                }
              }
            }
          },
          "afsluitreden": {
            "type": "string"
          },
          "afgesloten": {
            "type": "object",
            "properties": {
              "door": {
                "type": "string"
              },
              "tijd": {
                "type": "string"
              }
            }
          }
        }
      },
      "rules": {
        "read": "deelnames.partij = actor() OR team = actor('team') OR actor('rol') = 'kcc'",
        "create": "deelnames.partij = actor() OR team = actor('team')",
        "write": "team = actor('team')",
        "fields": [
          {
            "when": "actor('rol') = 'kcc'",
            "show": [
              "onderwerp",
              "status",
              "aanleiding",
              "team",
              "gestart",
              "afgesloten"
            ]
          }
        ]
      }
    },
    "nl.vng.gesprekken.bijdrage": {
      "queryable": [
        "gesprek",
        "door",
        "tijd",
        "automatisch"
      ],
      "schema": {
        "type": "object",
        "required": [
          "gesprek",
          "tekst",
          "door",
          "tijd"
        ],
        "properties": {
          "gesprek": {
            "type": "string"
          },
          "tekst": {
            "type": "string",
            "minLength": 1
          },
          "door": {
            "type": "string"
          },
          "tijd": {
            "type": "string"
          },
          "automatisch": {
            "type": "boolean"
          }
        }
      },
      "rules": {
        "read": "gesprek.deelnames.partij = actor() OR gesprek.team = actor('team')"
      }
    }
  },
  "actions": {
    "nl.vng.gesprekken.gesprek.gestart": {
      "title": "Gesprek starten",
      "commits": [
        {
          "type": "nl.vng.gesprekken.gesprek",
          "op": "create",
          "fields": [
            "onderwerp",
            "team",
            "aanleiding",
            "deelnames"
          ],
          "set": {
            "status": "open",
            "gestart": "$time"
          }
        },
        {
          "type": "nl.vng.gesprekken.bijdrage",
          "op": "create",
          "fields": [
            "gesprek",
            "tekst"
          ],
          "set": {
            "door": "$actor",
            "tijd": "$time"
          },
          "rule": "gesprek.deelnames.partij = actor() OR gesprek.team = actor('team')"
        }
      ]
    },
    "nl.vng.gesprekken.deelname.toegevoegd": {
      "title": "Deelnemer toevoegen",
      "commits": [
        {
          "type": "nl.vng.gesprekken.gesprek",
          "op": "update",
          "fields": [
            "deelnames"
          ],
          "rule": "team = actor('team') AND status = 'open'"
        }
      ]
    },
    "nl.vng.gesprekken.bijdrage.toegevoegd": {
      "title": "Bijdrage plaatsen",
      "commits": [
        {
          "type": "nl.vng.gesprekken.bijdrage",
          "op": "create",
          "fields": [
            "gesprek",
            "tekst",
            "automatisch"
          ],
          "set": {
            "door": "$actor",
            "tijd": "$time"
          },
          "rule": "(gesprek.deelnames.partij = actor() OR gesprek.team = actor('team')) AND gesprek.status = 'open'"
        }
      ]
    },
    "nl.vng.gesprekken.gesprek.afgesloten": {
      "title": "Gesprek afsluiten",
      "commits": [
        {
          "type": "nl.vng.gesprekken.gesprek",
          "op": "update",
          "fields": [
            "afsluitreden"
          ],
          "set": {
            "status": "afgesloten",
            "afgesloten": {
              "door": "$actor",
              "tijd": "$time"
            }
          },
          "rule": "(deelnames.partij = actor() OR team = actor('team')) AND status = 'open'"
        }
      ]
    }
  }
}
