{
  "id": "nl.vng.vergunningen",
  "version": "0.2.0",
  "title": "Aanvragen omgevingsvergunning (simulatievoorbeeld)",
  "personas": [
    {
      "id": "https://id.example.nl/jan",
      "label": "Jan (inwoner, aanvrager)",
      "claims": {
        "rol": "inwoner"
      }
    },
    {
      "id": "https://id.example.nl/femke",
      "label": "Femke (vergunningverlener)",
      "claims": {
        "rol": "medewerker",
        "team": "vergunningen"
      }
    },
    {
      "id": "https://id.example.nl/omgevingsloket",
      "label": "Omgevingsloket (DSO)",
      "claims": {
        "rol": "systeem"
      }
    }
  ],
  "types": {
    "nl.vng.vergunningen.aanvraag": {
      "queryable": [
        "status",
        "zaaknummer",
        "activiteiten",
        "procedure",
        "team",
        "behandelaar",
        "wijk",
        "aanvrager.partij",
        "uiterlijkeBeslisdatum",
        "besluit.uitkomst",
        "bekendgemaakt"
      ],
      "schema": {
        "type": "object",
        "required": [
          "zaaknummer",
          "activiteiten",
          "status",
          "aanvrager"
        ],
        "properties": {
          "zaaknummer": {
            "type": "string"
          },
          "verzoeknummer": {
            "type": "string"
          },
          "activiteiten": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "omschrijving": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ingediend",
              "in behandeling",
              "aanvulling gevraagd",
              "besloten",
              "ingetrokken"
            ]
          },
          "procedure": {
            "enum": [
              "regulier",
              "uitgebreid"
            ]
          },
          "locatie": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "const": "Point"
              },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "adres": {
            "type": "string"
          },
          "wijk": {
            "type": "string"
          },
          "kadastraal": {
            "type": "string"
          },
          "aanvrager": {
            "type": "object",
            "required": [
              "partij",
              "rol"
            ],
            "properties": {
              "partij": {
                "type": "string"
              },
              "rol": {
                "type": "string"
              }
            }
          },
          "gemachtigde": {
            "type": "string"
          },
          "bouwkosten": {
            "type": "integer"
          },
          "bijlagen": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "team": {
            "type": "string"
          },
          "behandelaar": {
            "type": "string"
          },
          "ingediend": {
            "type": "string"
          },
          "ontvankelijk": {
            "type": "string"
          },
          "uiterlijkeBeslisdatum": {
            "type": "string",
            "format": "date"
          },
          "verlengd": {
            "type": "boolean"
          },
          "verlengingsreden": {
            "type": "string"
          },
          "aanvullingGevraagd": {
            "type": "object",
            "required": [
              "gevraagd"
            ],
            "properties": {
              "gevraagd": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "termijnTot": {
                "type": "string",
                "format": "date"
              },
              "toelichting": {
                "type": "string"
              }
            }
          },
          "aanvullingOntvangen": {
            "type": "object",
            "properties": {
              "bijlagen": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "toelichting": {
                "type": "string"
              }
            }
          },
          "besluit": {
            "type": "object",
            "required": [
              "uitkomst"
            ],
            "properties": {
              "uitkomst": {
                "enum": [
                  "verleend",
                  "verleend met voorschriften",
                  "geweigerd",
                  "buiten behandeling"
                ]
              },
              "voorschriften": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "bezwaartermijnTot": {
                "type": "string",
                "format": "date"
              },
              "toelichting": {
                "type": "string"
              }
            }
          },
          "besloten": {
            "type": "string"
          },
          "bekendgemaakt": {
            "type": "boolean"
          },
          "bekendmaking": {
            "type": "object",
            "properties": {
              "publicatie": {
                "type": "string"
              }
            }
          },
          "intrekkingsreden": {
            "type": "string"
          },
          "ingetrokken": {
            "type": "string"
          }
        }
      },
      "rules": {
        "read": "aanvrager.partij = actor() OR gemachtigde = actor() OR team = actor('team') OR actor('rol') IN ('kcc', 'systeem') OR bekendgemaakt = true",
        "create": "aanvrager.partij = actor() OR actor('rol') = 'systeem'",
        "write": "team = actor('team') OR actor('rol') = 'systeem'",
        "fields": [
          {
            "when": "actor('rol') = 'kcc'",
            "show": [
              "zaaknummer",
              "activiteiten",
              "status",
              "procedure",
              "wijk",
              "ingediend",
              "uiterlijkeBeslisdatum",
              "besluit",
              "besloten"
            ]
          },
          {
            "when": "actor('rol') = 'inwoner' AND aanvrager.partij <> actor()",
            "show": [
              "zaaknummer",
              "activiteiten",
              "omschrijving",
              "adres",
              "locatie",
              "besluit",
              "bekendmaking"
            ]
          }
        ]
      }
    },
    "nl.vng.vergunningen.advies": {
      "queryable": [
        "aanvraag",
        "adviseur",
        "uitkomst"
      ],
      "schema": {
        "type": "object",
        "required": [
          "aanvraag",
          "adviseur"
        ],
        "properties": {
          "aanvraag": {
            "type": "string"
          },
          "adviseur": {
            "type": "string"
          },
          "vraag": {
            "type": "string"
          },
          "uitkomst": {
            "enum": [
              "positief",
              "positief met voorwaarden",
              "negatief"
            ]
          },
          "toelichting": {
            "type": "string"
          },
          "gevraagd": {
            "type": "string"
          },
          "ontvangen": {
            "type": "string"
          }
        }
      },
      "rules": {
        "read": "aanvraag.team = actor('team') OR actor('rol') IN ('kcc', 'systeem')"
      },
      "references": [
        "aanvraag"
      ]
    }
  },
  "actions": {
    "nl.vng.vergunningen.aanvraag.ingediend": {
      "title": "Aanvraag indienen",
      "commits": [
        {
          "type": "nl.vng.vergunningen.aanvraag",
          "op": "create",
          "fields": [
            "zaaknummer",
            "verzoeknummer",
            "activiteiten",
            "omschrijving",
            "procedure",
            "locatie",
            "adres",
            "wijk",
            "kadastraal",
            "aanvrager",
            "gemachtigde",
            "bouwkosten",
            "bijlagen"
          ],
          "set": {
            "team": "vergunningen",
            "status": "ingediend",
            "ingediend": "$time"
          }
        }
      ]
    },
    "nl.vng.vergunningen.aanvraag.ontvankelijk_verklaard": {
      "title": "Ontvankelijk verklaren",
      "commits": [
        {
          "type": "nl.vng.vergunningen.aanvraag",
          "op": "update",
          "fields": [
            "behandelaar",
            "uiterlijkeBeslisdatum"
          ],
          "set": {
            "status": "in behandeling",
            "ontvankelijk": "$time"
          }
        }
      ]
    },
    "nl.vng.vergunningen.aanvraag.aanvulling_gevraagd": {
      "title": "Aanvulling vragen",
      "commits": [
        {
          "type": "nl.vng.vergunningen.aanvraag",
          "op": "update",
          "fields": [
            "aanvullingGevraagd"
          ],
          "set": {
            "status": "aanvulling gevraagd"
          }
        }
      ]
    },
    "nl.vng.vergunningen.aanvraag.aanvulling_ontvangen": {
      "title": "Aanvulling aanleveren",
      "commits": [
        {
          "type": "nl.vng.vergunningen.aanvraag",
          "op": "update",
          "fields": [
            "aanvullingOntvangen"
          ],
          "set": {
            "status": "in behandeling"
          },
          "rule": "(aanvrager.partij = actor() OR gemachtigde = actor()) AND status = 'aanvulling gevraagd'"
        }
      ]
    },
    "nl.vng.vergunningen.aanvraag.advies_gevraagd": {
      "title": "Advies vragen",
      "commits": [
        {
          "type": "nl.vng.vergunningen.advies",
          "op": "create",
          "fields": [
            "aanvraag",
            "adviseur",
            "vraag"
          ],
          "set": {
            "gevraagd": "$time"
          },
          "rule": "aanvraag.team = actor('team')"
        }
      ]
    },
    "nl.vng.vergunningen.aanvraag.advies_ontvangen": {
      "title": "Advies vastleggen",
      "commits": [
        {
          "type": "nl.vng.vergunningen.advies",
          "op": "update",
          "fields": [
            "uitkomst",
            "toelichting"
          ],
          "set": {
            "ontvangen": "$time"
          },
          "rule": "aanvraag.team = actor('team')"
        }
      ]
    },
    "nl.vng.vergunningen.aanvraag.termijn_verlengd": {
      "title": "Termijn verlengen",
      "commits": [
        {
          "type": "nl.vng.vergunningen.aanvraag",
          "op": "update",
          "fields": [
            "uiterlijkeBeslisdatum",
            "verlengingsreden"
          ],
          "set": {
            "verlengd": true
          }
        }
      ]
    },
    "nl.vng.vergunningen.aanvraag.besloten": {
      "title": "Besluiten",
      "commits": [
        {
          "type": "nl.vng.vergunningen.aanvraag",
          "op": "update",
          "fields": [
            "besluit"
          ],
          "set": {
            "status": "besloten",
            "besloten": "$time"
          }
        }
      ]
    },
    "nl.vng.vergunningen.aanvraag.bekendgemaakt": {
      "title": "Bekendmaken",
      "commits": [
        {
          "type": "nl.vng.vergunningen.aanvraag",
          "op": "update",
          "fields": [
            "bekendmaking"
          ],
          "set": {
            "bekendgemaakt": true
          }
        }
      ]
    },
    "nl.vng.vergunningen.aanvraag.ingetrokken": {
      "title": "Intrekken",
      "commits": [
        {
          "type": "nl.vng.vergunningen.aanvraag",
          "op": "update",
          "fields": [
            "intrekkingsreden"
          ],
          "set": {
            "status": "ingetrokken",
            "ingetrokken": "$time"
          }
        }
      ]
    }
  }
}
