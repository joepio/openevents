            "type": "boolean"
          }
        }
      },
      "projection": [
        {
          "op": "append",
          "path": "betrokkenen",
          "value": {
            "url": "$data.patch.url",
            "roltype": "$data.patch.roltype",
            "omschrijvingGeneriek": "$data.patch.omschrijvingGeneriek",
            "betrokkeneType": "$data.patch.betrokkeneType",
            "betrokkene": "$data.patch.betrokkene"
          }
        },
        {
          "op": "append",
          "path": "rollen.{$data.patch.omschrijvingGeneriek}",
          "value": "$data.patch.betrokkeneIdentificatie.inpBsn"
        }
      ]
    },
    "nl.vng.zgw.zaken.resultaat.create": {
      "subjectType": "nl.vng.zgw.zaak",
      "right": "write",
      "dataschema": {
        "type": "object",
        "required": [
          "resourceUrl"
        ],
        "properties": {
          "patch": {
            "type": [
              "object",
