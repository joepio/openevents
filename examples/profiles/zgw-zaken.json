            ]
          },
          "resourceUrl": {
            "type": "string"
          },
          "kenmerken": {
            "type": [
              "object",
              "null"
            ]
          },
          "gespiegeld": {
            "type": "boolean"
          }
        }
      },
      "projection": [
        {
          "op": "merge",
          "path": "",
          "value": "$data.patch"
        }
      ]
    },
    "nl.vng.zgw.zaken.zaak.destroy": {
      "subjectType": "nl.vng.zgw.zaak",
      "right": "write",
      "dataschema": {
        "type": "object",
        "required": [
          "resourceUrl"
        ],
        "properties": {
          "patch": {
            "type": [
              "object",
              "null"
            ]
          },
          "resourceUrl": {
            "type": "string"
          },
          "kenmerken": {
            "type": [
              "object",
              "null"
            ]
          },
          "gespiegeld": {
            "type": "boolean"
          }
        }
      },
      "projection": [
        {
          "op": "set",
          "path": "verwijderd",
          "value": true
        }
      ]
    },
    "nl.vng.zgw.zaken.status.create": {
      "subjectType": "nl.vng.zgw.zaak",
      "right": "write",
      "dataschema": {
        "type": "object",
        "required": [
          "resourceUrl"
        ],
        "properties": {
          "patch": {
            "type": [
              "object",
              "null"
            ]
          },
          "resourceUrl": {
            "type": "string"
          },
          "kenmerken": {
            "type": [
              "object",
              "null"
            ]
          },
          "gespiegeld": {
            "type": "boolean"
          }
        }
      },
      "projection": [
        {
          "op": "set",
          "path": "huidigeStatus",
          "value": {
            "url": "$data.patch.url",
            "statustype": "$data.patch.statustype",
            "datumStatusGezet": "$data.patch.datumStatusGezet",
            "statustoelichting": "$data.patch.statustoelichting"
          }
        },
        {
          "op": "append",
          "path": "statussen",
          "value": {
            "url": "$data.patch.url",
            "statustype": "$data.patch.statustype",
            "datumStatusGezet": "$data.patch.datumStatusGezet"
          }
        }
      ]
    },
    "nl.vng.zgw.zaken.rol.create": {
      "subjectType": "nl.vng.zgw.zaak",
      "right": "write",
      "dataschema": {
        "type": "object",
        "required": [
          "resourceUrl"
        ],
        "properties": {
          "patch": {
            "type": [
              "object",
              "null"
            ]
          },
          "resourceUrl": {
            "type": "string"
          },
          "kenmerken": {
