{
  "id": "nl.vng.zgw.zaken",
  "version": "0.3.0",
  "title": "Zaakspiegel uit ZGW-notificaties (Open Zaak via Open Notificaties)",
  "personas": [
    {
      "id": "https://id.example.nl/behandelaar",
      "label": "Behandelaar (zaaktype bezwaar)",
      "claims": {
        "rol": "medewerker",
        "zaaktypen": [
          "https://openzaak.demodam.nl/catalogi/api/v1/zaaktypen/bezwaar"
        ]
      }
    },
    {
      "id": "https://id.example.nl/kim",
      "label": "Kim (KCC-medewerker)",
      "claims": {
        "rol": "kcc"
      }
    },
    {
      "id": "https://id.example.nl/priya",
      "label": "Priya (inwoner, BSN 999993653)",
      "claims": {
        "rol": "inwoner",
        "bsn": "999993653"
      }
    }
  ],
  "types": {
    "nl.vng.zgw.zaak": {
      "queryable": [
        "identificatie",
        "bronorganisatie",
        "zaaktype",
        "startdatum",
        "einddatum",
        "vertrouwelijkheidaanduiding",
        "status",
        "initiatorBsn"
      ],
      "schema": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "identificatie": {
            "type": "string"
          },
          "zaaktype": {
            "type": "string"
          },
          "initiatorBsn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "rules": {
        "read": "zaaktype = actor('zaaktypen') OR actor('rol') IN ('kcc', 'systeem') OR initiatorBsn = actor('bsn')",
        "write": "actor('rol') = 'systeem'",
        "create": "actor('rol') = 'systeem'",
        "fields": [
          {
            "when": "actor('rol') = 'kcc'",
            "show": [
              "identificatie",
              "omschrijving",
              "zaaktype",
              "startdatum",
              "einddatum",
              "status",
              "resultaat"
            ]
          }
        ],
        "mine": "initiatorBsn = actor('bsn')"
      }
    },
    "nl.vng.zgw.status": {
      "queryable": [
        "zaak",
        "statustype",
        "datumStatusGezet"
      ],
      "schema": {
        "type": "object",
        "required": [
          "url",
          "zaak"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "zaak": {
            "type": "string"
          }
        }
      },
      "rules": {
        "read": "zaak.zaaktype = actor('zaaktypen') OR actor('rol') IN ('systeem', 'kcc') OR zaak.initiatorBsn = actor('bsn')",
        "write": "actor('rol') = 'systeem'",
        "create": "actor('rol') = 'systeem'",
        "mine": "zaak.initiatorBsn = actor('bsn')"
      },
      "references": [
        "zaak"
      ]
    },
    "nl.vng.zgw.rol": {
      "queryable": [
        "zaak",
        "roltype",
        "omschrijvingGeneriek"
      ],
      "schema": {
        "type": "object",
        "required": [
          "url",
          "zaak"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "zaak": {
            "type": "string"
          }
        }
      },
      "rules": {
        "read": "zaak.zaaktype = actor('zaaktypen') OR actor('rol') IN ('systeem') OR zaak.initiatorBsn = actor('bsn')",
        "write": "actor('rol') = 'systeem'",
        "create": "actor('rol') = 'systeem'"
      },
      "references": [
        "zaak"
      ]
    },
    "nl.vng.zgw.resultaat": {
      "queryable": [
        "zaak",
        "resultaattype"
      ],
      "schema": {
        "type": "object",
        "required": [
          "url",
