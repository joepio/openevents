        "write": "actor('rol') = 'systeem'",
        "create": "actor('rol') = 'systeem'",
        "mine": "zaak.initiatorBsn = actor('bsn')"
      },
      "references": [
        "zaak"
      ]
    },
    "nl.vng.zgw.zaakobject": {
      "queryable": [
        "zaak",
        "object",
        "objectType"
      ],
      "schema": {
        "type": "object",
