          "value": "$data.patch.informatieobject"
        }
      ]
    },
    "nl.vng.zgw.zaken.zaakobject.create": {
      "subjectType": "nl.vng.zgw.zaak",
      "right": "write",
      "dataschema": {
        "type": "object",
